@page "/"
@using SharpTrace.Core.Models
@using SharpTrace.Core.Parsers
@using SharpTrace.Core.Filters
@using SharpTrace.Core.Samples
@using SharpTrace.Components
@inject IJSRuntime JS

<div class="sharptrace-app" @ondragover="HandleDragOver" @ondragleave="HandleDragLeave" @ondrop="HandleDrop">
    <!-- Top Application Toolbar -->
    <header class="app-toolbar">
        <div class="toolbar-brand">
            <div class="brand-logo">
                <span class="logo-pulse"></span>
                <span class="logo-icon">📡</span>
            </div>
            <div class="brand-text">
                <span class="brand-name">SharpTrace</span>
                <span class="brand-badge">WASM .NET 8</span>
            </div>
        </div>

        <div class="toolbar-actions">
            <!-- Open File -->
            <label class="btn-action file-input-label" title="Open PCAP or PCAPNG capture file">
                <span class="icon">📁</span> Open File
                <InputFile OnChange="HandleFileSelected" accept=".pcap,.pcapng,.cap" style="display: none;" />
            </label>

            <!-- Sample Captures Dropdown -->
            <div class="sample-picker">
                <span class="sample-label">Sample:</span>
                <select class="sample-select" @onchange="HandleSampleSelect">
                    <option value="" disabled selected="@(_currentSample == "")">Select built-in sample...</option>
                    <option value="dns" selected="@(_currentSample == "dns")">DNS Lookup (A & AAAA Records)</option>
                    <option value="tcp" selected="@(_currentSample == "tcp")">TCP 3-Way Handshake & TLS</option>
                    <option value="http" selected="@(_currentSample == "http")">HTTP GET Request & Response</option>
                </select>
            </div>

            <!-- Analytics Button -->
            <button class="btn-action" @onclick="() => _showStatsModal = true" disabled="@(_allPackets.Count == 0)" title="View protocol analytics and metrics">
                <span class="icon">📊</span> Statistics
            </button>

            <!-- Clear Button -->
            <button class="btn-action btn-danger" @onclick="ClearCapture" disabled="@(_allPackets.Count == 0)" title="Clear loaded packets">
                <span class="icon">🗑</span> Clear
            </button>

            <!-- Packet Counter Badge -->
            <div class="packet-counter">
                @if (_allPackets.Count > 0)
                {
                    <span class="counter-text">
                        Packets: <strong>@_filteredPackets.Count</strong> / @_allPackets.Count
                        @if (_filteredPackets.Count != _allPackets.Count)
                        {
                            <span class="filter-active-pill">FILTERED</span>
                        }
                    </span>
                }
                else
                {
                    <span class="counter-text text-muted">No capture loaded</span>
                }
            </div>
        </div>
    </header>

    <!-- Wireshark Query Filter Bar -->
    <div class="filter-section">
        <FilterBar OnFilterApplied="HandleFilterApplied" />
    </div>

    <!-- Main 3-Pane Body -->
    <main class="analyzer-workspace">
        <!-- Top Pane: Packet List -->
        <div class="pane-top">
            <PacketList Packets="_filteredPackets"
                        SelectedPacket="_selectedPacket"
                        OnPacketSelected="HandlePacketSelected" />
        </div>

        <div class="pane-splitter-horizontal">
            <span class="splitter-handle">···</span>
        </div>

        <!-- Bottom Panes (Details & Hex) -->
        <div class="pane-bottom">
            <!-- Bottom Left: Packet Details Tree -->
            <div class="pane-details">
                <PacketDetailsTree Packet="_selectedPacket"
                                   OnRangeSelected="HandleRangeSelected" />
            </div>

            <div class="pane-splitter-vertical"></div>

            <!-- Bottom Right: Hex & ASCII Inspector -->
            <div class="pane-hex">
                <HexView RawBytes="_selectedPacket?.RawBytes"
                         SelectedRange="_selectedRange"
                         OnByteClicked="HandleByteClicked" />
            </div>
        </div>
    </main>

    <!-- Bottom Status Strip -->
    <footer class="app-statusbar">
        <div class="status-left">
            @if (_isLoading)
            {
                <span class="status-loading"><span class="spinner"></span> Parsing capture data...</span>
            }
            else if (!string.IsNullOrEmpty(_statusMessage))
            {
                <span>@_statusMessage</span>
            }
            else
            {
                <span>Ready. Drag & drop a .pcap file anywhere to inspect.</span>
            }
        </div>
        <div class="status-right">
            <span>SharpTrace WebAssembly Engine</span>
            <span class="sep">•</span>
            <span>Profile: Zero-Allocation Spans</span>
        </div>
    </footer>

    <!-- Drag-and-drop overlay indicator -->
    @if (_isDraggingOver)
    {
        <div class="drag-drop-overlay">
            <div class="drag-drop-modal">
                <div class="drag-icon">📥</div>
                <div class="drag-title">Drop PCAP file to analyze</div>
                <div class="drag-desc">Supports classic .pcap (LE/BE) and .pcapng files</div>
            </div>
        </div>
    }

    <!-- Statistics Modal -->
    <StatisticsModal IsOpen="_showStatsModal"
                     IsOpenChanged="(open) => _showStatsModal = open"
                     Packets="_allPackets" />
</div>

@code {
    private List<PacketModel> _allPackets = new();
    private List<PacketModel> _filteredPackets = new();
    private PacketModel? _selectedPacket;
    private ByteHighlightRange? _selectedRange;
    private FilterNode? _currentFilter;
    private string _currentSample = "";
    private bool _isLoading = false;
    private bool _showStatsModal = false;
    private bool _isDraggingOver = false;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        // Load default DNS sample automatically so reviewers immediately see interactive data!
        await LoadSample("dns");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            _isLoading = true;
            _statusMessage = $"Reading {file.Name} ({file.Size} bytes)...";
            StateHasChanged();

            // Allow up to 100 MB captures in browser memory
            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            byte[] fileBytes = ms.ToArray();

            _statusMessage = $"Parsing packets...";
            StateHasChanged();

            var packets = await CaptureFileParser.ParseAsync(fileBytes);
            _allPackets = packets;
            _currentSample = "";
            ApplyFilter();

            _statusMessage = $"Loaded {packets.Count} packets from {file.Name}";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error parsing file: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSampleSelect(ChangeEventArgs e)
    {
        string sampleKey = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(sampleKey))
        {
            await LoadSample(sampleKey);
        }
    }

    private async Task LoadSample(string sampleKey)
    {
        _isLoading = true;
        _currentSample = sampleKey;
        StateHasChanged();

        try
        {
            byte[] bytes = sampleKey switch
            {
                "dns" => SampleCaptureGenerator.GenerateDnsSample(),
                "tcp" => SampleCaptureGenerator.GenerateTcpHandshakeSample(),
                "http" => SampleCaptureGenerator.GenerateHttpSample(),
                _ => SampleCaptureGenerator.GenerateDnsSample()
            };

            var packets = await CaptureFileParser.ParseAsync(bytes);
            _allPackets = packets;
            ApplyFilter();

            string sampleTitle = sampleKey switch
            {
                "dns" => "DNS Lookup fixture",
                "tcp" => "TCP Handshake fixture",
                "http" => "HTTP GET fixture",
                _ => "Sample"
            };
            _statusMessage = $"Loaded {packets.Count} packets ({sampleTitle})";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error loading sample: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearCapture()
    {
        _allPackets.Clear();
        _filteredPackets.Clear();
        _selectedPacket = null;
        _selectedRange = null;
        _currentSample = "";
        _statusMessage = "Capture cleared.";
    }

    private void HandlePacketSelected(PacketModel packet)
    {
        _selectedPacket = packet;
        // Select entire frame by default on selection
        _selectedRange = new ByteHighlightRange(0, packet.RawBytes.Length, "Frame");
    }

    private void HandleRangeSelected(ByteHighlightRange range)
    {
        _selectedRange = range;
    }

    private void HandleByteClicked(int offset)
    {
        _selectedRange = new ByteHighlightRange(offset, 1, $"Offset 0x{offset:X4}");
    }

    private void HandleFilterApplied(FilterNode? node)
    {
        _currentFilter = node;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_currentFilter == null)
        {
            _filteredPackets = new List<PacketModel>(_allPackets);
        }
        else
        {
            _filteredPackets = _allPackets
                .Where(p => FilterEvaluator.Evaluate(_currentFilter, p))
                .ToList();
        }

        // Maintain or update selected packet
        if (_selectedPacket != null && !_filteredPackets.Any(p => p.Number == _selectedPacket.Number))
        {
            _selectedPacket = _filteredPackets.FirstOrDefault();
            _selectedRange = _selectedPacket != null ? new ByteHighlightRange(0, _selectedPacket.RawBytes.Length, "Frame") : null;
        }
        else if (_selectedPacket == null && _filteredPackets.Count > 0)
        {
            _selectedPacket = _filteredPackets.First();
            _selectedRange = new ByteHighlightRange(0, _selectedPacket.RawBytes.Length, "Frame");
        }
    }

    private void HandleDragOver(DragEventArgs e)
    {
        _isDraggingOver = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _isDraggingOver = false;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDraggingOver = false;
    }
}
